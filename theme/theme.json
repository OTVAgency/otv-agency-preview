{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"color": {
			"palette": [
				{ "slug": "black", "color": "#0b0d0f", "name": "Black" },
				{ "slug": "charcoal", "color": "#181d22", "name": "Charcoal" },
				{ "slug": "surface", "color": "#1f252b", "name": "Surface" },
				{ "slug": "muted", "color": "#8b939a", "name": "Muted" },
				{ "slug": "muted-light", "color": "#a8b4bc", "name": "Muted Light" },
				{ "slug": "cream", "color": "#e8eef2", "name": "Cream" },
				{ "slug": "cream-deep", "color": "#232a30", "name": "Cream Deep" },
				{ "slug": "white", "color": "#f7fafc", "name": "White" },
				{ "slug": "cyan", "color": "#48d0e8", "name": "Cyan" },
				{ "slug": "cyan-deep", "color": "#1ba8c4", "name": "Cyan Deep" },
				{ "slug": "navy", "color": "#48d0e8", "name": "Cyan (legacy alias)" },
				{ "slug": "navy-deep", "color": "#1ba8c4", "name": "Cyan Deep (legacy alias)" }
			]
		},
		"layout": {
			"contentSize": "1140px",
			"wideSize": "1140px"
		},
		"typography": {
			"fontFamilies": [
				{
					"fontFamily": "\"Instrument Serif\", Georgia, serif",
					"name": "Instrument Serif",
					"slug": "instrument-serif"
				},
				{
					"fontFamily": "\"DM Sans\", system-ui, sans-serif",
					"name": "DM Sans",
					"slug": "dm-sans"
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--black)",
			"text": "var(--wp--preset--color--cream)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--dm-sans)",
			"fontSize": "1.0625rem",
			"lineHeight": "1.7"
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	],
	"customTemplates": [
		{ "name": "front-page", "title": "Front Page", "postTypes": ["page"] }
	]
}
